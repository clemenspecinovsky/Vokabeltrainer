{
  "name": "vokabeltrainer",
  "version": "1.0.0",
  "private": true,
  "description": "Manga-style vocabulary trainer for kids",
  "scripts": {
    "dev": "next dev -H 192.168.179.152",
    "dev:default": "next dev",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https --experimental-https-key ./certs/dev-key.pem --experimental-https-cert ./certs/dev-cert.pem",
    "cert:install": "mkcert -install",
    "cert:new": "mkcert -cert-file ./certs/dev-cert.pem -key-file ./certs/dev-key.pem localhost 127.0.0.1 ::1 192.168.179.152",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p Unittests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "next": "^16.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
